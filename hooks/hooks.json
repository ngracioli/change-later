{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-file-size.js"],
            "statusMessage": "Checking file size..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(cat *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-bash-read.js"],
            "statusMessage": "Checking file size..."
          },
          {
            "type": "command",
            "if": "Bash(head *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-bash-read.js"],
            "statusMessage": "Checking file size..."
          },
          {
            "type": "command",
            "if": "Bash(tail *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-bash-read.js"],
            "statusMessage": "Checking file size..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop.js"],
            "statusMessage": "Caching bulk-reader summary..."
          }
        ]
      }
    ]
  }
}
